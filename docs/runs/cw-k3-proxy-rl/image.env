# Kimi K3 vLLM image, resolved on an x86_64 Slurm node.
# The requested mirror currently publishes only the arm64 child; keep it as
# provenance, but use the same release's official multi-architecture tag.
K3_REQUESTED_IMAGE=docker://aosheninferact/vllm-openai:kimi-k3
K3_IMAGE=docker://vllm/vllm-openai:kimi-k3
K3_IMAGE_INDEX_DIGEST=sha256:e90e2603b2781936651ba019804137714367c69e10a7b25a2e57b46995225616
K3_IMAGE_AMD64_DIGEST=sha256:fb16b180bd9727600067e16fcd6a6de43fb4db1baf4298ef20b4dbdf6bfa5a0e
# Set K3_IMAGE_SQSH after running cache_image.sbatch. Runtime jobs reuse that
# immutable file instead of asking pyxis to import 40 Docker layers per job.
K3_RUNTIME_IMAGE="${K3_IMAGE_SQSH:-${K3_IMAGE}}"
K3_TRAINING_IMAGE=/lustre/fs1/portfolios/coreai/projects/coreai_devtech_all/users/bayan/code/env/pytorch_26.04-py3.sqsh
K3_MEGATRON_ROOT=/lustre/fs1/portfolios/coreai/projects/coreai_devtech_all/users/bayan/code/runtime/ds4-csacp-parity-eaa5b486d/mcore
K3_FLA_SITE=/lustre/fs1/portfolios/coreai/projects/coreai_devtech_all/users/bayan/code/mlite-newenv-cache/qwen35-proven-canary-site
K3_MLITE_SM90_SITE=/lustre/fs1/portfolios/coreai/projects/coreai_devtech_all/users/bayan/code/mlite-2604-verl-dsa-sm90-overlay/lib/python3.12/site-packages
K3_TRAINING_VLLM_SITE=/lustre/fs1/portfolios/coreai/projects/coreai_devtech_all/users/bayan/code/mlite-2612-cu13-canonical/vllm0251-site

