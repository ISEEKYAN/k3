# Kimi K3 vLLM image, resolved on an x86_64 Slurm node.
# The requested mirror currently publishes only the arm64 child; keep it as
# provenance, but use the same release's official multi-architecture tag.
K3_REQUESTED_IMAGE=docker://aosheninferact/vllm-openai:kimi-k3
K3_IMAGE=docker://vllm/vllm-openai:kimi-k3
K3_IMAGE_INDEX_DIGEST=sha256:e90e2603b2781936651ba019804137714367c69e10a7b25a2e57b46995225616
K3_IMAGE_AMD64_DIGEST=sha256:fb16b180bd9727600067e16fcd6a6de43fb4db1baf4298ef20b4dbdf6bfa5a0e
# Set K3_IMAGE_SQSH after running cache_image.sbatch. Runtime jobs reuse that
# immutable file instead of asking pyxis to import 40 Docker layers per job.
K3_RUNTIME_IMAGE="${K3_IMAGE_SQSH:-${K3_IMAGE}}"

# Source pins used by the training-side overlay.
K3_BASE_SOURCE_SHA=58535fb5b7705f840c6641bb7607e1838ad10c1b
MLITE_SOURCE_SHA=85eacfbc1acbcfef9b003e0301d409be464d1377
TE_SOURCE_SHA=8b9968255eb879e6e390f427836906b29aad64d2
VERL_SOURCE_SHA=8446ee4b1eb786402f9feecf76b778fd8922b883
